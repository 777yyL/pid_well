# IT must replace the hostname and install the matching corporate certificate.
# This assumes Nginx runs on the same host as the Compose application.
server {
    listen 80;
    server_name tender-test.company.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name tender-test.company.internal;
    ssl_certificate /etc/ssl/enterprise/tender-test.crt;
    ssl_certificate_key /etc/ssl/enterprise/tender-test.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
