# Copy to the repository root as .env on the company test server.
COMPOSE_PROJECT_NAME=tender-test
APP_IMAGE=tender-agent-workspace:test
# Generate with: openssl rand -hex 24
# Use hex to avoid URL escaping issues in DATABASE_URL.
POSTGRES_PASSWORD=
# Generate separately with: openssl rand -hex 32
# Keep this stable and back it up securely.
APP_ENCRYPTION_KEY=
COOKIE_SECURE=true
PUBLIC_BASE_URL=
MAX_CONCURRENT_RUNS=2
# Automatic checkpoint interval, not the total task limit.
MAX_AGENT_TURNS=40
MAX_TOTAL_AGENT_TURNS=400
MAX_NO_PROGRESS_TURNS=12
# 30-minute task deadline for the departmental test environment.
RUN_TIMEOUT_MS=1800000
# Model requests stop after 2 minutes without stream activity, or 10 minutes total.
MODEL_IDLE_TIMEOUT_MS=120000
MODEL_REQUEST_TIMEOUT_MS=600000
RUN_HEARTBEAT_MS=5000
