# Generate independent random hex values for all six secrets before startup.
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_PASSWORD=
LF_SALT=
LF_AUTH_SECRET=
# Must be exactly 64 hexadecimal characters. Keep this key stable after deployment.
LF_ENCRYPTION_KEY=
# Use the same tested v4 image version for web and worker (minimum 4.59.0).
LF_IMAGE_TAG=4
LF_BIND_ADDRESS=127.0.0.1
LF_PUBLIC_URL=http://localhost:53000
