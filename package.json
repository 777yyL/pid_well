{
  "name": "tender-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --external vite --out-dir dist/server --sourcemap",
    "start": "node --use-system-ca dist/server/index.js",
    "test": "tsx --import ./tests/env.mjs --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "evaluate:accuracy": "tsx scripts/evaluate-accuracy.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.27.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.0.0",
    "zod": "^4.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "prettier": "^3.6.0"
  }
}
