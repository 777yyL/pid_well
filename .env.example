HOST=127.0.0.1
PORT=4317
# Set the URL colleagues use to open shared results, e.g. http://192.168.1.10:4317
PUBLIC_BASE_URL=
# Local persistent PostgreSQL engine is used when DATABASE_URL is empty.
# Department deployment should use a dedicated PostgreSQL database.
DATABASE_URL=
DATA_DIR=./data
# Set a stable 64-character hex key for encryption when deploying.
APP_ENCRYPTION_KEY=
# Enable behind an HTTPS reverse proxy.
COOKIE_SECURE=false
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=900000
MODEL_REQUEST_TIMEOUT_MS=600000
MODEL_IDLE_TIMEOUT_MS=120000
RUN_HEARTBEAT_MS=5000
MAX_AGENT_TURNS=40
# Automatic checkpoint/compaction interval; task continues within the total budget.
MAX_TOTAL_AGENT_TURNS=400
MAX_NO_PROGRESS_TURNS=12

# Quick assessment: clause limit per request (also limited by output budget), model workers.
QUICK_BATCH_SIZE=10
QUICK_CONCURRENCY=2

# Optional Langfuse (self-hosted or cloud). Project API keys; never use model API keys here.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development

# Scoped semantic + keyword retrieval. Base URL should include /v1 when required.
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_REVISION=1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=30000
SEMANTIC_TOP_K=10
