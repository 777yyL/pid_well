HOST=127.0.0.1
PORT=4317
# Local persistent PostgreSQL engine is used when DATABASE_URL is empty.
# Department deployment should use a dedicated PostgreSQL database.
DATABASE_URL=
DATA_DIR=./data
# Set a stable 64-character hex key for encryption when deploying.
APP_ENCRYPTION_KEY=
# Enable behind an HTTPS reverse proxy.
COOKIE_SECURE=false
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=900000
MAX_AGENT_TURNS=40
# Automatic checkpoint/compaction interval; task continues within the total budget.
MAX_TOTAL_AGENT_TURNS=400
MAX_NO_PROGRESS_TURNS=12
